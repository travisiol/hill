# HILL — environment
#
# Every one of these is optional and the site is honest without them. With the
# contract addresses unset, the standings are empty, the pot is zero, the claim
# button is disabled with its reason written underneath, and "What stands"
# reports 2/8. Nothing here fakes a deployment that has not happened.

# ---- the site ------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://hill.example
NEXT_PUBLIC_HILL_X=
NEXT_PUBLIC_HILL_TELEGRAM=

# ---- the contracts -------------------------------------------------------
# The token, the crown module, and the pool the fee is collected from. The
# pool is also the first address that must be excluded from the standings —
# an unfiltered largest-holder crown belongs to the pool forever.
NEXT_PUBLIC_HILL_TOKEN_ADDRESS=
NEXT_PUBLIC_HILL_CROWN_ADDRESS=
NEXT_PUBLIC_HILL_POOL_ADDRESS=

# The master switch. Even set to true, the surfaces above stay disabled until
# their addresses are present — this flag can only turn things off.
NEXT_PUBLIC_HILL_LIVE=false

# ---- the chain -----------------------------------------------------------
# Defaults are in src/lib/chain.ts and were gathered from public third-party
# sources. Re-verify against the official docs before pointing this at real
# funds.
NEXT_PUBLIC_ROBINHOOD_CHAIN_ID=4663
NEXT_PUBLIC_ROBINHOOD_RPC_URL=
NEXT_PUBLIC_ROBINHOOD_EXPLORER_URL=
